{
  "name": "@charles_lindecker/pvzf-console",
  "version": "1.5.0",
  "description": "Translation toolkit for Plants vs Zombies: Fusion. Scans localization files, generates per-locale reports, and exports Trello CSVs.",
  "keywords": [
    "pvz",
    "plants-vs-zombies",
    "fusion",
    "translation",
    "localization",
    "cli",
    "trello"
  ],
  "author": "Charles Lindecker <charles.lindecker@outlook.fr>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pvzf-console": "dist/cli.js"
  },
  "files": [
    "dist/",
    "data/",
    "README.md",
    "README.dist.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:security": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LINDECKER-Charles/PVZ-Fuzion-ConsolManager.git"
  }
}
