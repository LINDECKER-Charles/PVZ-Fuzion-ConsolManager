{
  "name": "@charles_lindecker/pvzf-console",
  "version": "1.3.0",
  "description": "Translation toolkit for Plants vs Zombies: Fusion. Scans localization files, generates per-locale reports, and exports Trello CSVs.",
  "keywords": [
    "pvz",
    "plants-vs-zombies",
    "fusion",
    "translation",
    "localization",
    "cli",
    "trello"
  ],
  "author": "Charles Lindecker <charles.lindecker@outlook.fr>",
  "license": "MIT",
  "bin": {
    "pvzf-console": "bin/pvzf-console.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "data/",
    "README.md",
    "README.dist.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node bin/build.js",
    "prepublishOnly": "node bin/build.js",
    "test": "node --test tests-js/build.test.js tests-js/pvzf-console.test.js",
    "test:cov": "c8 --reporter=text --reporter=lcov --include=bin/*.js --lines=75 --functions=75 --branches=75 --statements=75 node --test tests-js/build.test.js tests-js/pvzf-console.test.js"
  },
  "devDependencies": {
    "c8": "^10.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LINDECKER-Charles/PVZ-Fuzion-ConsolManager.git"
  }
}
